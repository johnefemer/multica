{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenthost-docs",
  // Static-export deployment: `next build` (with `output: "export"` in
  // next.config.mjs) produces `apps/docs/out/` — a plain HTML/asset
  // directory CF Pages serves directly. No Workers runtime involved,
  // so no compatibility_flags needed.
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "apps/docs/out"
}
