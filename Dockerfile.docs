# --- Dependencies ---
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy workspace config and the package.json files needed to resolve the docs
# subgraph. Anything @multica/docs imports — only @multica/ui today — must be
# present, plus the shared tsconfig/eslint workspaces so pnpm doesn't error
# on missing references.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
# Copy EVERY workspace package.json. The builder stage later does a
# `COPY packages/` which surfaces packages/{views,core,...} and their
# package.json files; pnpm then tries to install their deps in offline
# mode against the store warmed here. If a workspace package is missing
# from the deps stage, its dependencies aren't downloaded, the offline
# install can't resolve them, and the build fails with
# `ERR_PNPM_NO_OFFLINE_TARBALL`. So: warm the store with EVERY workspace
# entry, even ones the docs app doesn't directly import.
COPY apps/desktop/package.json apps/desktop/
COPY apps/docs/package.json apps/docs/
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/ui/package.json packages/ui/
COPY packages/views/package.json packages/views/

# `apps/docs/package.json` declares `postinstall: fumadocs-mdx`, which reads
# `apps/docs/source.config.ts` to generate the `.source/` content map. The
# postinstall fires as part of `pnpm install`, so the config has to be in
# place beforehand — otherwise the install errors with
# `Could not resolve "/app/apps/docs/source.config.ts"`.
COPY apps/docs/source.config.ts apps/docs/

RUN pnpm install --frozen-lockfile

# --- Build ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy installed dependencies (preserves pnpm symlink structure)
COPY --from=deps /app ./

# Copy source
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/docs/ apps/docs/
COPY packages/ packages/

# Re-link after source overlay (fixes any symlinks overwritten by COPY).
# Lifecycle scripts run here, including the docs app's `postinstall:
# fumadocs-mdx` which materialises the MDX content index in `.source/`.
RUN pnpm install --frozen-lockfile --offline

# next.config.mjs gates `output: "standalone"` on this env var so dev /
# typecheck builds don't pay the standalone tracing cost.
ENV STANDALONE=true

# Build the docs app. `pnpm @multica/docs build` runs `fumadocs-mdx`
# (regenerates the index) then `next build` (compiles + traces the
# standalone output).
RUN pnpm --filter @multica/docs build

# --- Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output (includes traced node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/standalone ./
# Copy static files (not included in standalone)
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/static ./apps/docs/.next/static
# Copy fumadocs-mdx generated source index — read at runtime by the docs
# layout to enumerate pages, breadcrumbs, sidebar, etc.
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.source ./apps/docs/.source

USER nextjs

# Internal-only port. The web container proxies /docs/* to docs:4000 via
# the DOCS_URL env var; nothing on the host or the public internet talks
# to this container directly.
EXPOSE 4000
ENV PORT=4000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/docs/server.js"]
